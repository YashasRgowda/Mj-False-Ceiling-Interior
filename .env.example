# Copy to .env.local and fill in. Never commit the filled-in file.

# ---- Supabase Postgres ----
# Connect button in the Supabase dashboard -> ORM tab.
# Percent-encode the password if it contains @ # / ? : %
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ---- Payload ----
# Any long random string: openssl rand -hex 32
PAYLOAD_SECRET=

# ---- Supabase project ----
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Supabase Storage (S3-compatible) ----
# Storage -> S3 Access Keys
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=media
S3_REGION=ap-south-1

# ---- Password-reset email (Gmail App Password, not the account password) ----
SMTP_USER=
SMTP_PASS=

# ---- Public address of the site ----
# Must match the live domain in production or reset links point at localhost.
NEXT_PUBLIC_SERVER_URL=http://localhost:3100
